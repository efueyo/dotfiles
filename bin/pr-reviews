#!/usr/bin/env bash

set -euo pipefail

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    printf '%s\n' \
        'Usage: pr-reviews [SEARCH_QUERY]' \
        '' \
        'Select pending PR reviews in the current repo and open pi in tmux windows.' \
        'Default search: user-review-requested:@me (direct requests only)' \
        'Use Tab to select multiple PRs, Enter to launch, Escape to cancel.' \
        'Requires gh (authenticated), fzf, tmux, pi, and the review-pr skill.'
    exit 0
fi
if [[ $# -gt 1 ]]; then
    printf 'Pass the search query as a single quoted argument.\n' >&2
    exit 1
fi

for tool in gh fzf tmux pi; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        printf 'Missing required command: %s\n' "$tool" >&2
        exit 1
    fi
done

cwd=$PWD
pi_command=$(command -v pi)
prs=$(gh pr list --state open --search "${1:-user-review-requested:@me draft:false}" --limit 1000 \
    --json number,title,author \
    --jq '.[] | [.number, .title, .author.login] | @tsv')
if [[ -z $prs ]]; then
    printf 'No matching pending PRs in this repository.\n'
    exit 0
fi

if selected=$(printf '%s\n' "$prs" | fzf --multi --delimiter=$'\t' \
    --prompt='Review PRs> ' --header='Tab: select · Enter: launch · Esc: cancel'); then
    :
else
    status=$?
    # No match or user cancellation is not an error.
    if [[ $status == 1 || $status == 130 ]]; then
        exit 0
    fi
    exit "$status"
fi
[[ -n $selected ]] || exit 0

session=''
if [[ -n ${TMUX:-} ]]; then
    session=$(tmux display-message -p '#{session_id}')
fi

while IFS=$'\t' read -r number _; do
    [[ $number =~ ^[0-9]+$ ]] || { printf 'Invalid PR number: %s\n' "$number" >&2; exit 1; }
    if [[ -z $session ]]; then
        session=$(tmux new-session -d -P -F '#{session_id}' -c "$cwd" \
            -n "pr-$number" "$pi_command" "/skill:review-pr $number")
    else
        tmux new-window -d -t "$session:" -c "$cwd" -n "pr-$number" \
            "$pi_command" "/skill:review-pr $number"
    fi
done <<< "$selected"

if [[ -z ${TMUX:-} ]]; then
    exec tmux attach-session -t "$session"
fi
